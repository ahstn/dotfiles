{
  "theme": "catppuccin-frappe",
  "defaultModel": "gpt-5.6-sol",
  "defaultProvider": "openai-codex",
  "defaultThinkingLevel": "medium",
  "lastChangelogVersion": "0.84.2",
  "packages": [
    "npm:pi-subagents",
    "npm:pi-extmgr",
    "npm:pi-token-burden",
    "npm:pi-context-view",
    "npm:pi-mcp-adapter",
    "npm:pi-tool-display",
    "npm:@juicesharp/rpiv-todo",
    "npm:@juicesharp/rpiv-ask-user-question"
  ],

  // Ensure packages land in Mise's node_modules, 
  // min-release-age and ignore-scripts to aid in supply chain attack prevention.
  "npmCommand": [
    "mise",
    "exec",
    "node@lts",
    "--",
    "npm",
    "--min-release-age=24h",
    "--ignore-scripts"
  ],

  // Compact at UPPER_BOUND - 20K tokens, and keep the most recent 10K tokens.
  "compaction": {
    "enabled": true,
    "reserveTokens": 20480,
    "keepRecentTokens": 10240
  },

  // Emit install/update version ping, but disable data sharing.
  "enableInstallTelemetry": true,
  "enableAnalytics": false,

  // pi-subagent configuration
  // Thinking levels in model ID to allow altering levels per fallback model, e.g. 5.6-sol:medium -> 5.6-luna:xhigh.
  "subagents": {
    "agentOverrides": {
      "delegate": {
        "model": "openai-codex/gpt-5.6-luna:high"
      },
      "oracle": {
        "model": "openai-codex/gpt-5.6-sol:xhigh"
      },
      "researcher": {
        "model": "openai-codex/gpt-5.6-luna:high"
      },
      "reviewer": {
        "model": "openai-codex/gpt-5.6-sol:high",
        "fallbackModels": [
          "github-copilot/gpt-5.6-sol:high"
        ]
      },
      "scout": {
        "model": "openrouter/google/gemini-3.7-flash:high",
        "fallbackModels": [
          "openai-codex/gpt-5.6-luna:high"
        ]
      },
      "worker": {
        "model": "openai-codex/gpt-5.6-sol:medium"
      }
    }
  }
}