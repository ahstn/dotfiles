{
  "theme": "catppuccin-frappe",
  "defaultModel": "gpt-5.6-sol",
  "defaultProvider": "openai-codex",
  "defaultThinkingLevel": "medium",
  "lastChangelogVersion": "0.84.4",
  "collapseChangelog": true,
  "shellCommandPrefix": "export PATH=\"$HOME/.local/share/mise/shims:$PATH\"",
  "packages": [
    "npm:pi-subagents",
    "npm:pi-extmgr",
    "npm:pi-token-burden",
    "npm:pi-context-view",
    "npm:pi-mcp-adapter",
    "npm:pi-tool-display",
    "npm:@juicesharp/rpiv-todo",
    "npm:@juicesharp/rpiv-ask-user-question"
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 20480,
    "keepRecentTokens": 10240
  },
  "enableInstallTelemetry": true,
  "enableAnalytics": false,
  "subagents": {
    "defaultModel": "gpt-5.6-sol",
    "modelScope": {
      "enforce": true,
      "strict": true,
      "allow": [
        "inherit",
        "openai-codex/gpt-5.6-*",
        "github-copilot/gpt-5.6-*",
        "openrouter/google/gemini-3.7-flash"
      ]
    },
    "agentOverrides": {
      "delegate": {
        "model": "openai-codex/gpt-5.6-luna:high"
      },
      "oracle": {
        "model": "openai-codex/gpt-5.6-sol:xhigh"
      },
      "researcher": {
        "model": "openai-codex/gpt-5.6-luna:high"
      },
      "reviewer": {
        "model": "openai-codex/gpt-5.6-sol:high",
        "fallbackModels": [
          "github-copilot/gpt-5.6-sol:high"
        ]
      },
      "scout": {
        "model": "openrouter/google/gemini-3.7-flash:high",
        "fallbackModels": [
          "openai-codex/gpt-5.6-luna:high"
        ]
      },
      "worker": {
        "model": "openai-codex/gpt-5.6-sol:medium"
      }
    }
  }
}