{
  "project_key": "string (required)",
  "jira_instance_url": "string (required) - jira url, typically https://<company>.atlassian.net",
  "team_name": "string (required)",
  "board_id": "string|number",
  "priorities": {
    "critical": "string (production outage, data loss, security breach)",
    "high": "string (major feature broken, significant user impact)",
    "standard": "string (default for ordinary work)",
    "low": "string (minor improvement)",
    "backlog": "string (future consideration)"
  },
  "description_attribution": "Generated By: Pi π",
  "story_points_field": {
    "field_id": "customfield_<your-story-points-id>",
    "name": "Story Points"
  },
  "custom_fields": [
    {
      "field_id": "customfield_<your-acceptance-criteria-id>",
      "name": "Acceptance Criteria",
      "required": false,
      "guidance": "Add acceptance criteria to tasks, stories, and bugs"
    },
    {
      "field_id": "customfield_<your-team-name-id>",
      "name": "Team Name",
      "required": true
    }
  ],
  "issue_types": {
    "string|number": "string (type name)"
  },
  // Quick lookup for recent epics, but shouldn't be accepted as an exhaustive search
  // Only if the current task fits into one of these - otherwise search JIRA itself.
  "recent_epics": {
    "string": "string, description, guidance, etc"
  }
}
