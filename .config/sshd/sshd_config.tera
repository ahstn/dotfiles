{#-
  Ephemeral, LAN-only sshd for short (1-3h) sessions. Rendered by `mise dot apply`.

  Inputs (environment variables read at render time, all optional):
    SSHD_LISTEN      address:port to bind   default: <en0 IPv4>:48222
    SSHD_USER        account allowed in     default: $USER
    SSHD_ALLOW_FROM  comma-separated client IPs/CIDRs   default: 192.168.1.168

  e.g. SSHD_ALLOW_FROM=192.168.1.168,192.168.1.20 mise dot apply ~/.config/sshd/sshd_config
-#}
{%- set home = env.HOME -%}
{%- set user = env?.SSHD_USER or env.USER -%}
{%- set allow_from = env?.SSHD_ALLOW_FROM or "192.168.1.168" -%}
{%- if env?.SSHD_LISTEN -%}
  {%- set listen = env.SSHD_LISTEN -%}
{%- else -%}
  {%- set listen = exec(command="ipconfig getifaddr en0 || echo 127.0.0.1") | trim ~ ":48222" -%}
{%- endif -%}
# Generated by mise from ~/git/dotfiles/.config/sshd/sshd_config.tera - edit the source.
ListenAddress {{ listen }}

HostKey {{ home }}/.config/sshd/ssh_host_ed25519_key
PidFile {{ home }}/.config/sshd/sshd.pid

# Keys only - a dedicated list, so temporary sessions never inherit every key in ~/.ssh/authorized_keys.
AuthorizedKeysFile {{ home }}/.config/sshd/authorized_keys
PubkeyAuthentication yes
AuthenticationMethods publickey
PasswordAuthentication no
KbdInteractiveAuthentication no
HostbasedAuthentication no
PermitEmptyPasswords no
PermitRootLogin no
UsePAM no
StrictModes yes

# Only this user, only from these hosts. Unlisted users/sources are refused after connect.
AllowUsers{% for ip in allow_from | split(pat=",") %} {{ user }}@{{ ip | trim }}{% endfor %}

# Throttle and bound anything that does reach us.
LoginGraceTime 20
MaxAuthTries 3
MaxSessions 4
MaxStartups 3:50:10
ClientAliveInterval 300
ClientAliveCountMax 2

# No forwarding of any kind (X11, agent, TCP, unix sockets) and no tunnels.
DisableForwarding yes
PermitTunnel no
PermitUserRC no
PermitUserEnvironment no

# No file transfer subsystem: sftp (and therefore modern `scp`/`sftp`) is unavailable
# because no `Subsystem` line is declared. Legacy `scp -O` and `rsync` still work by
# exec'ing a remote command; to block those too, force every session to a shell
# (this also disables `ssh host <command>`):
# ForceCommand /bin/zsh -l

PrintMotd no
LogLevel VERBOSE
