{#-
  Preview with `mise exec -- mise bootstrap files apply --dry-run`, then run
  `mise exec -- mise bootstrap files apply --yes` and
  `sudo systemctl restart tern-remote`.
  `mise exec` exports the private [env] values for bootstrap's secret inputs.

  Keep private values in ignored mise.local.toml (chmod 600):
    [vars]
    tern_users = "local-user,root"
    [env]
    TERN_TAILSCALE_EMAIL = { value = "you@example.com", redact = true }
    TERN_SSH_FINGERPRINT = { value = "SHA256:your-fingerprint", redact = true }

  tern_users is comma-separated, without spaces. Both methods use this list.
  Root must be named explicitly: "*" excludes accounts with uid 0.
  Tailscale access requires the named identity over the Tailscale interface
  and firewall rules that prevent other sources from spoofing tailnet addresses.
  SSH keys must also be in each target user's ~/.ssh/authorized_keys.
-#}
# Generated by Mise from .config/tern/access.toml.tera.
# Edit the template and private inputs, not this generated file.
tailscale = true

[[allow]]
method = "tailscale"
identity = {{ secret(name="tern_tailscale_email") | json_encode }}
users = {{ vars.tern_users | split(pat=",") | json_encode }}

[[allow]]
method = "ssh-key"
identity = {{ secret(name="tern_ssh_fingerprint") | json_encode }}
users = {{ vars.tern_users | split(pat=",") | json_encode }}
