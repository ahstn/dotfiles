{
  "$schema": "https://opencode.ai/config.json",

  // Use the existing Exa connection; never track its API key here.
  "websearch": { "provider": "exa" },

  // Prefer the source skills over automatically discovered compatibility copies.
  "skills": ["~/git/dotfiles/skills"],

  // Cached upstream checkouts are read-only and may lag the installed version.
  "references": {
    "axum": {
      "repository": "tokio-rs/axum",
      "description": "Consult for Axum routing and middleware internals; check Cargo.lock before relying on upstream behavior. Treat the cached checkout as read-only.",
    },
    "tanstack-router": {
      "repository": "TanStack/router",
      "description": "Consult for TanStack Router and Start internals; check installed versions first. Treat the cached checkout as read-only.",
    },
    "opencode": {
      "repository": "anomalyco/opencode",
      "description": "Consult for OpenCode V2 internals and plugin APIs. Use https://opencode.ai/v2/docs/ as the configuration contract and check the installed version. Treat the cached checkout as read-only.",
    },
    "dotfiles": {
      "path": "~/git/dotfiles",
      "description": "Local ahstn/dotfiles checkout: consult for shared agent skills, shell settings, and mise-managed configuration. Inspect AGENTS.md and existing changes before editing; never commit machine-local credentials or work copies.",
    },
  },

  // Model selection and credentials remain machine-local.
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },

    // V2 external-directory access: ask outside the two trusted boundaries.
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "~/git/dotfiles/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.cache/github/*", "effect": "allow" },

    // Adapted from oceans-llm/crates/gateway-guardrails/src/packs/.
    // These are command-text wildcards, NOT the packs' semantic evaluator.
    // Leading * covers common wrappers/global options, but can also match data.
    // Last matching rule wins: approval rules first, irreversible blocks last.

    // core.filesystem: conservative approval for removal and content loss.
    { "action": "shell", "resource": "*rm *", "effect": "ask" },
    { "action": "shell", "resource": "*rmdir *", "effect": "ask" },
    { "action": "shell", "resource": "*unlink *", "effect": "ask" },
    { "action": "shell", "resource": "*truncate *", "effect": "ask" },
    { "action": "shell", "resource": "*wipefs *", "effect": "ask" },
    { "action": "shell", "resource": "dd *", "effect": "ask" },
    { "action": "shell", "resource": "* dd *", "effect": "ask" },
    { "action": "shell", "resource": "*/dd *", "effect": "ask" },
    { "action": "shell", "resource": "*find *-delete*", "effect": "ask" },

    // core.git: preserve local work, recovery history, and remote references.
    // Some safe variants (restore --staged, clean --dry-run) also ask.
    { "action": "shell", "resource": "*git *checkout *-- *", "effect": "ask" },
    { "action": "shell", "resource": "*git *checkout *--pathspec-from-file*", "effect": "ask" },
    { "action": "shell", "resource": "*git *checkout *--force*", "effect": "ask" },
    { "action": "shell", "resource": "*git *checkout *-f*", "effect": "ask" },
    { "action": "shell", "resource": "*git *checkout *-B*", "effect": "ask" },
    { "action": "shell", "resource": "*git *switch *--force*", "effect": "ask" },
    { "action": "shell", "resource": "*git *switch *--discard-changes*", "effect": "ask" },
    { "action": "shell", "resource": "*git *switch *-f*", "effect": "ask" },
    { "action": "shell", "resource": "*git *switch *-C*", "effect": "ask" },
    { "action": "shell", "resource": "*git *restore *", "effect": "ask" },
    { "action": "shell", "resource": "*git *reset *--hard*", "effect": "ask" },
    { "action": "shell", "resource": "*git *reset *--merge*", "effect": "ask" },
    { "action": "shell", "resource": "*git *clean *", "effect": "ask" },
    { "action": "shell", "resource": "*git *push *--force*", "effect": "ask" },
    { "action": "shell", "resource": "*git *push *-f*", "effect": "ask" },
    { "action": "shell", "resource": "*git *push *--mirror*", "effect": "ask" },
    { "action": "shell", "resource": "*git *push *--prune*", "effect": "ask" },
    { "action": "shell", "resource": "*git *push *--delete*", "effect": "ask" },
    { "action": "shell", "resource": "*git *push *-d*", "effect": "ask" },
    { "action": "shell", "resource": "*git *push *:*", "effect": "ask" },
    { "action": "shell", "resource": "*git *push *+*", "effect": "ask" },
    { "action": "shell", "resource": "*git *branch *-d*", "effect": "ask" },
    { "action": "shell", "resource": "*git *branch *-D*", "effect": "ask" },
    { "action": "shell", "resource": "*git *branch *-f*", "effect": "ask" },
    { "action": "shell", "resource": "*git *branch *-M*", "effect": "ask" },
    { "action": "shell", "resource": "*git *branch *-C*", "effect": "ask" },
    { "action": "shell", "resource": "*git *branch *--delete*", "effect": "ask" },
    { "action": "shell", "resource": "*git *branch *--force*", "effect": "ask" },
    { "action": "shell", "resource": "*git *worktree *remove *", "effect": "ask" },
    { "action": "shell", "resource": "*git *worktree *add *-B*", "effect": "ask" },
    { "action": "shell", "resource": "*git *submodule *--force*", "effect": "ask" },
    { "action": "shell", "resource": "*git *submodule *-f*", "effect": "ask" },
    { "action": "shell", "resource": "*git *rm *-f*", "effect": "ask" },
    { "action": "shell", "resource": "*git *mv *-f*", "effect": "ask" },
    { "action": "shell", "resource": "*git *mv *--force*", "effect": "ask" },
    { "action": "shell", "resource": "*git *checkout-index *", "effect": "ask" },
    { "action": "shell", "resource": "*git *read-tree *", "effect": "ask" },
    { "action": "shell", "resource": "*git *prune *", "effect": "ask" },
    { "action": "shell", "resource": "*git *gc *--prune*", "effect": "ask" },
    { "action": "shell", "resource": "*git *repack *--cruft-expiration*", "effect": "ask" },
    { "action": "shell", "resource": "*git *reflog *expire *", "effect": "ask" },
    { "action": "shell", "resource": "*git *reflog *delete *", "effect": "ask" },
    { "action": "shell", "resource": "*git *reflog *drop *", "effect": "ask" },
    { "action": "shell", "resource": "*git *send-pack *", "effect": "ask" },
    { "action": "shell", "resource": "*git *http-push *", "effect": "ask" },
    { "action": "shell", "resource": "*git *stash *drop *", "effect": "ask" },
    { "action": "shell", "resource": "*git *stash *clear *", "effect": "ask" },

    // kubernetes.kubectl / kubernetes.helm: dry-run variants also ask.
    { "action": "shell", "resource": "*kubectl *delete *", "effect": "ask" },
    { "action": "shell", "resource": "*kubectl *drain *", "effect": "ask" },
    { "action": "shell", "resource": "*kubectl *cordon *", "effect": "ask" },
    { "action": "shell", "resource": "*kubectl *taint *:NoExecute*", "effect": "ask" },
    { "action": "shell", "resource": "*kubectl *scale *--replicas*0*", "effect": "ask" },
    { "action": "shell", "resource": "*kubectl *apply *--prune*", "effect": "ask" },
    { "action": "shell", "resource": "*kubectl *apply *--force*", "effect": "ask" },
    { "action": "shell", "resource": "*kubectl *replace *--force*", "effect": "ask" },
    { "action": "shell", "resource": "*kubectl *auth *reconcile *--remove-extra-*", "effect": "ask" },
    { "action": "shell", "resource": "*helm *uninstall *", "effect": "ask" },
    { "action": "shell", "resource": "*helm *delete *", "effect": "ask" },
    { "action": "shell", "resource": "*helm *del *", "effect": "ask" },
    { "action": "shell", "resource": "*helm *un *", "effect": "ask" },
    { "action": "shell", "resource": "*helm *rollback *", "effect": "ask" },
    { "action": "shell", "resource": "*helm *upgrade *--force*", "effect": "ask" },
    { "action": "shell", "resource": "*helm *upgrade *--reset-values*", "effect": "ask" },
    { "action": "shell", "resource": "*helm *install *--cleanup-on-fail*", "effect": "ask" },
    { "action": "shell", "resource": "*helm *upgrade *--cleanup-on-fail*", "effect": "ask" },
    { "action": "shell", "resource": "*helm *install *--rollback-on-failure*", "effect": "ask" },
    { "action": "shell", "resource": "*helm *upgrade *--rollback-on-failure*", "effect": "ask" },

    // secrets.aws_secrets / secrets.onepassword: mutations and access changes.
    { "action": "shell", "resource": "*aws *secretsmanager *delete-*", "effect": "ask" },
    { "action": "shell", "resource": "*aws *secretsmanager *remove-regions-from-replication*", "effect": "ask" },
    { "action": "shell", "resource": "*aws *secretsmanager *update-secret*", "effect": "ask" },
    { "action": "shell", "resource": "*aws *secretsmanager *rotate-secret*", "effect": "ask" },
    { "action": "shell", "resource": "*aws *secretsmanager *cancel-rotate-secret*", "effect": "ask" },
    { "action": "shell", "resource": "*aws *secretsmanager *stop-replication-to-replica*", "effect": "ask" },
    { "action": "shell", "resource": "*aws *secretsmanager *put-secret-value*", "effect": "ask" },
    { "action": "shell", "resource": "*aws *ssm *delete-*", "effect": "ask" },
    { "action": "shell", "resource": "*aws *ssm *put-parameter *--overwrite*", "effect": "ask" },
    { "action": "shell", "resource": "*op *item *delete *", "effect": "ask" },
    { "action": "shell", "resource": "*op *document *delete *", "effect": "ask" },
    { "action": "shell", "resource": "*op *vault *delete *", "effect": "ask" },
    { "action": "shell", "resource": "*op *user *delete *", "effect": "ask" },
    { "action": "shell", "resource": "*op *group *delete *", "effect": "ask" },
    { "action": "shell", "resource": "*op *connect *token *delete *", "effect": "ask" },
    { "action": "shell", "resource": "*op *item *edit *", "effect": "ask" },
    { "action": "shell", "resource": "*op *document *edit *", "effect": "ask" },
    { "action": "shell", "resource": "*op *item *move *", "effect": "ask" },
    { "action": "shell", "resource": "*op *user *suspend *", "effect": "ask" },
    { "action": "shell", "resource": "*op *group *user *revoke *", "effect": "ask" },
    { "action": "shell", "resource": "*op *vault *group *revoke *", "effect": "ask" },
    { "action": "shell", "resource": "*op *vault *user *revoke *", "effect": "ask" },
    { "action": "shell", "resource": "*op *connect *group *revoke *", "effect": "ask" },
    { "action": "shell", "resource": "*op *connect *vault *revoke *", "effect": "ask" },
    { "action": "shell", "resource": "*op *connect *server *delete *", "effect": "ask" },

    // database.snowflake: SQL cannot be classified safely with wildcards.
    // Ask for all SQL and code execution, including SELECT/file/stdin queries.
    { "action": "shell", "resource": "*snow *sql *", "effect": "ask" },
    { "action": "shell", "resource": "*snow *object *drop *", "effect": "ask" },
    { "action": "shell", "resource": "*snow *stage *drop *", "effect": "ask" },
    { "action": "shell", "resource": "*snow *stage *remove *", "effect": "ask" },
    { "action": "shell", "resource": "*snow *git *drop *", "effect": "ask" },
    { "action": "shell", "resource": "*snow *streamlit *drop *", "effect": "ask" },
    { "action": "shell", "resource": "*snow *dcm *drop*", "effect": "ask" },
    { "action": "shell", "resource": "*snow *dcm *purge *", "effect": "ask" },
    { "action": "shell", "resource": "*snow *app *teardown *", "effect": "ask" },
    { "action": "shell", "resource": "*snow *app *version *drop *", "effect": "ask" },
    { "action": "shell", "resource": "*snow *snowpark *drop *", "effect": "ask" },
    { "action": "shell", "resource": "*snow *spcs *drop *", "effect": "ask" },
    { "action": "shell", "resource": "*snow *spcs *compute-pool *stop-all *", "effect": "ask" },
    { "action": "shell", "resource": "*snow *spcs *service *suspend *", "effect": "ask" },
    { "action": "shell", "resource": "*snow *dbt *drop *", "effect": "ask" },
    { "action": "shell", "resource": "*snow *dbt *deploy *--force*", "effect": "ask" },
    { "action": "shell", "resource": "*snow *dbt *deploy *-f*", "effect": "ask" },
    { "action": "shell", "resource": "*snow *dbt *execute *", "effect": "ask" },
    { "action": "shell", "resource": "*snow *stage *copy *--overwrite*", "effect": "ask" },
    { "action": "shell", "resource": "*snow *dbt *copy *--overwrite*", "effect": "ask" },
    { "action": "shell", "resource": "*snow *streamlit *deploy *--replace*", "effect": "ask" },
    { "action": "shell", "resource": "*snow *streamlit *deploy *--prune*", "effect": "ask" },
    { "action": "shell", "resource": "*snow *notebook *deploy *--replace*", "effect": "ask" },
    { "action": "shell", "resource": "*snow *notebook *deploy *--prune*", "effect": "ask" },
    { "action": "shell", "resource": "*snow *stage *execute *", "effect": "ask" },
    { "action": "shell", "resource": "*snow *git *execute *", "effect": "ask" },

    // saas.github: gh counterparts and MCP tools. Grouped tools ask for all
    // methods because OpenCode MCP permissions cannot inspect their arguments.
    { "action": "shell", "resource": "*gh *pr *merge *", "effect": "ask" },
    { "action": "shell", "resource": "*gh *pr *close *", "effect": "ask" },
    { "action": "shell", "resource": "*gh *issue *close *", "effect": "ask" },
    { "action": "shell", "resource": "*gh *run *cancel *", "effect": "ask" },
    { "action": "shell", "resource": "*gh *run *delete *", "effect": "ask" },
    { "action": "shell", "resource": "*gh *project *delete *", "effect": "ask" },
    { "action": "shell", "resource": "*gh *label *delete *", "effect": "ask" },
    { "action": "shell", "resource": "*gh *api *", "effect": "ask" },
    { "action": "*github*_delete_file", "resource": "*", "effect": "ask" },
    { "action": "*github*_merge_pull_request", "resource": "*", "effect": "ask" },
    { "action": "*github*_delete_pending_pull_request_review", "resource": "*", "effect": "ask" },
    { "action": "*github*_remove_sub_issue", "resource": "*", "effect": "ask" },
    { "action": "*github*_create_or_update_file", "resource": "*", "effect": "ask" },
    { "action": "*github*_actions_run_trigger", "resource": "*", "effect": "ask" },
    { "action": "*github*_cancel_workflow_run", "resource": "*", "effect": "ask" },
    { "action": "*github*_delete_workflow_run_logs", "resource": "*", "effect": "ask" },
    { "action": "*github*_update_pull_request", "resource": "*", "effect": "ask" },
    { "action": "*github*_update_pull_request_state", "resource": "*", "effect": "ask" },
    { "action": "*github*_pull_request_review_write", "resource": "*", "effect": "ask" },
    { "action": "*github*_projects_write", "resource": "*", "effect": "ask" },
    { "action": "*github*_delete_project_item", "resource": "*", "effect": "ask" },
    { "action": "*github*_label_write", "resource": "*", "effect": "ask" },
    { "action": "*github*_discussion_comment_write", "resource": "*", "effect": "ask" },
    { "action": "*github*_issue_write", "resource": "*", "effect": "ask" },
    { "action": "*github*_update_issue_state", "resource": "*", "effect": "ask" },
    { "action": "*github*_sub_issue_write", "resource": "*", "effect": "ask" },
    { "action": "*github*_issue_dependency_write", "resource": "*", "effect": "ask" },
    { "action": "*github*_set_issue_fields", "resource": "*", "effect": "ask" },

    // core.shell / core.filesystem: block host power changes and disk disposal.
    { "action": "shell", "resource": "*shutdown *", "effect": "deny" },
    { "action": "shell", "resource": "*reboot *", "effect": "deny" },
    { "action": "shell", "resource": "*poweroff *", "effect": "deny" },
    { "action": "shell", "resource": "*halt *", "effect": "deny" },
    { "action": "shell", "resource": "*systemctl *poweroff*", "effect": "deny" },
    { "action": "shell", "resource": "*systemctl *reboot*", "effect": "deny" },
    { "action": "shell", "resource": "*systemctl *halt*", "effect": "deny" },
    { "action": "shell", "resource": "*systemctl *kexec*", "effect": "deny" },
    { "action": "shell", "resource": "*init *", "effect": "deny" },
    { "action": "shell", "resource": "*telinit *", "effect": "deny" },
    { "action": "shell", "resource": "*mkfs*", "effect": "deny" },
    { "action": "shell", "resource": "*kill * 1", "effect": "deny" },
    { "action": "shell", "resource": "*kill 1 *", "effect": "deny" },
    { "action": "shell", "resource": "*kill * 1 *", "effect": "deny" },
    { "action": "shell", "resource": "*kill * -1*", "effect": "deny" },
    { "action": "shell", "resource": "*shred *", "effect": "deny" },
    { "action": "shell", "resource": "dd *of=/dev/*", "effect": "deny" },
    { "action": "shell", "resource": "* dd *of=/dev/*", "effect": "deny" },
    { "action": "shell", "resource": "*/dd *of=/dev/*", "effect": "deny" },
    { "action": "shell", "resource": "*wipefs *--all*", "effect": "deny" },
    { "action": "shell", "resource": "*wipefs *-a*", "effect": "deny" },
    { "action": "shell", "resource": "*wipefs *--offset*", "effect": "deny" },
    { "action": "shell", "resource": "*wipefs *-o*", "effect": "deny" },
    { "action": "shell", "resource": "*diskutil *erase*", "effect": "deny" },
    { "action": "shell", "resource": "*diskutil *partition*", "effect": "deny" },
    { "action": "shell", "resource": "*diskutil *deleteVolume*", "effect": "deny" },
    { "action": "shell", "resource": "*gh *repo *delete *", "effect": "deny" },
    { "action": "*github*_delete_repository", "resource": "*", "effect": "deny" },

    // secret_disclosure: do not print credentials into the agent transcript.
    // Prefer op run / infisical run / doppler run for process-only injection.
    { "action": "shell", "resource": "*op *read *", "effect": "deny" },
    { "action": "shell", "resource": "*op *item *get *", "effect": "deny" },
    { "action": "shell", "resource": "*op *document *get *", "effect": "deny" },
    { "action": "shell", "resource": "*op *inject *", "effect": "deny" },
    { "action": "shell", "resource": "*op *environment *read *", "effect": "deny" },
    { "action": "shell", "resource": "*op *connect *token *create *", "effect": "deny" },
    { "action": "shell", "resource": "*op *service-account *create *", "effect": "deny" },
    { "action": "shell", "resource": "*op *signin *--raw*", "effect": "deny" },
    { "action": "shell", "resource": "*op *account *add *--raw*", "effect": "deny" },
    { "action": "shell", "resource": "*infisical *secrets *", "effect": "deny" },
    { "action": "shell", "resource": "*infisical *export *", "effect": "deny" },
    { "action": "shell", "resource": "*infisical *dynamic-secrets *lease *create *", "effect": "deny" },
    { "action": "shell", "resource": "*doppler *secrets *", "effect": "deny" },
    { "action": "shell", "resource": "*vault *read *", "effect": "deny" },
    { "action": "shell", "resource": "*vault *kv *get *", "effect": "deny" },
    { "action": "shell", "resource": "*vault *login *", "effect": "deny" },
    { "action": "shell", "resource": "*vault *token *create *", "effect": "deny" },
    { "action": "shell", "resource": "*vault *operator *init *", "effect": "deny" },
    { "action": "shell", "resource": "*vault *operator *rekey *", "effect": "deny" },
    { "action": "shell", "resource": "*vault *operator *generate-root *", "effect": "deny" },
    { "action": "shell", "resource": "*aws *secretsmanager *get-secret-value*", "effect": "deny" },
    { "action": "shell", "resource": "*aws *secretsmanager *batch-get-secret-value*", "effect": "deny" },
    { "action": "shell", "resource": "*aws *secretsmanager *get-random-password*", "effect": "deny" },
    { "action": "shell", "resource": "*aws *ssm *get-parameter*--with-decryption*", "effect": "deny" },
    { "action": "shell", "resource": "*aws *ssm *--with-decryption*get-parameter*", "effect": "deny" },
  ],

  // Preserve the existing formatter preference; do not add idle model usage.
  "formatter": {
    "prettier": { "disabled": true },
  },
  "warming": false,
}
