# Copy to config.env (git-ignored) and edit. Environment variables override this file.
# Never put VM_TAILSCALE_AUTHKEY or VM_PASSWORD here; export them for the one run instead.

# VM_OS=ubuntu                  # ubuntu | macos
# VM_NAME=ubuntu-dev            # default: ubuntu-dev / macos-dev
# VM_SYSTEM=download:ubuntu     # a `vmpal systems` ID for VM_OS (Ubuntu 26.04 or macOS); default: download:ubuntu / download:macOS
# VM_CPU=6                      # default: half the host's cores
# VM_MEMORY_GB=8
# VM_DISK_GB=64                 # grow only; default: 64 / 100
# VM_ROSETTA=1                  # Ubuntu only: run x86_64 Linux apps (tty7, MonoCode, Paseo desktops)

# Host folder shared live into the guest at /media/VMPal/<name> (Ubuntu) or
# "/Volumes/My Shared Files/<name>" (macOS), linked as ~/host-<name>.
# VM_SHARE_DIR=$HOME/git        # empty = no share
# VM_SHARE_NAME=git

# VM_SSH_PUBKEY=$HOME/.ssh/id_ed25519.pub               # authorised for SSH into the guest
# VM_GITHUB_AUTH_KEY=$HOME/.ssh/github                  # empty = skip
# VM_GITHUB_SIGNING_KEY=$HOME/.ssh/github-signing-key   # empty = skip

# VMPAL=$HOME/.local/bin/vmpal  # override the CLI path
