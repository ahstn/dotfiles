# Copy to config.env (git-ignored) and edit. Environment variables override this file.
# Never put VM_TAILSCALE_AUTHKEY or a real VM_PASSWORD here; export them for the one run instead.

# VM_OS=macos                   # macos | ubuntu
# VM_NAME=macos-dev             # default: macos-dev / ubuntu-dev
# VM_SYSTEM=download:macOS      # a `vmpal systems` ID for VM_OS; default: download:macOS (latest) / download:ubuntu
# VM_USER=admin                 # guest account, at create only; default: admin / this Mac's user (Linux reserves admin)
# VM_PASSWORD=admin             # set by `all`; default: admin (as Tart) / empty = keep VMPal's generated password
# VM_CPU=6                      # default: half the host's cores, at most its performance cores
# VM_MEMORY_GB=8
# VM_DISK_GB=100                # grow only; default: 100 / 64
# VM_ROSETTA=1                  # Ubuntu only: run x86_64 Linux apps (tty7, MonoCode, Paseo desktops)

# Networking. bridged gives the guest its own LAN address, for SSH from other devices (`vm.sh sshd`).
# VM_NETWORK=shared             # shared (NAT, this Mac only) | bridged | host-only
# VM_BRIDGE=auto                # bridged only: en0, en1, ... (vmpal info lists them) or auto
# VM_LOCAL_NETWORK=default      # on | off | default (VMPal Settings): 2nd NIC on 192.168.128.x with this Mac and its VMs
# VM_SSHD_PORT=48222
# VM_SSHD_ALLOW_FROM=192.168.1.168                     # LAN client IPs/CIDRs, comma-separated
# VM_SSHD_AUTHORIZED_KEYS=$VM_SSH_PUBKEY               # the LAN client's public key(s)

# Host folder shared live into the guest at /media/VMPal/<name> (Ubuntu) or
# "/Volumes/My Shared Files/<name>" (macOS), linked as ~/<name>.
# VM_SHARE_DIR=$HOME/shared     # created if missing; empty = no share. Not for repositories
# VM_SHARE_NAME=shared

# VM_SSH_PUBKEY=$HOME/.ssh/id_ed25519.pub               # authorised for SSH into the guest
# VM_GITHUB_AUTH_KEY=$HOME/.ssh/github                  # empty = skip
# VM_GITHUB_SIGNING_KEY=$HOME/.ssh/github-signing-key   # empty = skip

# VMPAL=$HOME/.local/bin/vmpal  # override the CLI path
