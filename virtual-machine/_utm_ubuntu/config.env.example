# Copy to config.env (gitignored) to override defaults. All values are optional.
# Precedence: exported environment variables > this file > built-in defaults.
# VM_PASSWORD and VM_TAILSCALE_AUTHKEY are deliberately not stored here: export them for the command that needs them.

VM_NAME=ubuntu-dev
VM_HOSTNAME=ubuntu-dev
VM_USER="$(id -un)"
VM_MEMORY_MIB=8192
VM_DISK_MIB=65536
VM_CPU_CORES=0                       # 0 = host performance-core count
VM_SHARE_DIR="$HOME/git"             # host folder exposed over VirtFS (mounted at ~/utm)
VM_SSH_PUBKEY="$HOME/.ssh/id_ed25519.pub"
VM_PASSWORDLESS_SUDO=1               # needed for unattended mise bootstrap
VM_LOCALE=en_US.UTF-8
VM_KEYBOARD=us
VM_TIMEZONE=Etc/UTC
UBUNTU_ISO_URL=https://cdimage.ubuntu.com/releases/26.04/release/ubuntu-26.04.1-desktop-arm64.iso
VM_SSH_LOCAL_PORT=2222               # 127.0.0.1:2222 -> guest :22 (provisioning/admin, loopback only)
VM_SSHD_PORT=48222                   # <LAN addr>:48222 -> guest :48222 (ephemeral sshd)
VM_SSHD_FWD_ADDR=                    # host address to bind; empty = en0 IPv4, 0.0.0.0 = all interfaces
VM_SSHD_ALLOW_FROM=10.0.2.2,192.168.1.168  # LAN client IPs/CIDRs; 10.0.2.2 = the host itself (QEMU NAT)
VM_SSHD_AUTHORIZED_KEYS=             # public key file of the LAN client(s) allowed in; empty = VM_SSH_PUBKEY
VM_GITHUB_AUTH_KEY="$HOME/.ssh/github"                 # copied into the guest for git@github.com; empty = skip
VM_GITHUB_SIGNING_KEY="$HOME/.ssh/github-signing-key"  # copied for SSH commit signing; empty = skip
GRUB_AUTOINSTALL=0                  # 1 = send "autoinstall" kernel arg at GRUB (unverified)
GRUB_LINUX_LINE_DOWNS=1              # arrow-downs from top of GRUB editor to the `linux` line
