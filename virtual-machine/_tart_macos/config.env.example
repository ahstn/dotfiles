# Copy to config.env (git-ignored) and edit. Environment variables override this file.
# Never put VM_TAILSCALE_AUTHKEY here; export it for the one provision run instead.

# VM_NAME=macos-dev
# VM_IMAGE=ghcr.io/cirruslabs/macos-tahoe-base:latest
# VM_USER=admin                 # the base image's account
# VM_IMAGE_PASSWORD=admin       # its published password; only used to install the SSH key
# VM_CPU=6                      # default: half the host's cores
# VM_MEMORY_MIB=8192
# VM_DISK_GB=100                # grow only
# VM_DISPLAY=1920x1200
# VM_HEADLESS=0                 # 1 = no window

# Host folder shared into the guest at "/Volumes/My Shared Files/<name>" (linked as ~/host-<name>).
# VM_SHARE_DIR=$HOME/git        # empty = no share
# VM_SHARE_NAME=git

# nat: only this Mac reaches the guest. bridged: the guest gets its own LAN address (needed for `sshd`).
# VM_NET=nat
# VM_BRIDGE_IF=en0

# VM_SSH_PUBKEY=$HOME/.ssh/id_ed25519.pub
# VM_SSHD_PORT=48222
# VM_SSHD_ALLOW_FROM=192.168.1.168
# VM_SSHD_AUTHORIZED_KEYS=$VM_SSH_PUBKEY
# VM_GITHUB_AUTH_KEY=$HOME/.ssh/github                  # empty = skip
# VM_GITHUB_SIGNING_KEY=$HOME/.ssh/github-signing-key   # empty = skip
